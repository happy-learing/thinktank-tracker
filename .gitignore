# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example

# Runtime state. Sources and prompt versions are exchanged through sources.json,
# not by committing a workstation database or API credentials.
workspace/
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.log

# Bundled browser binaries are reproducibly installed by the build script.
runtime/browsers/

# PyInstaller, debug, QA, and release outputs
.build/
.debug-build/
debug-dist/
dist/
release/
.portable-qa/
.package-inspect/
*.spec.bak

# Editor and operating-system metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
